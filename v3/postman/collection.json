    {
      "name": "2. Register User",
      "item": [
        {
          "name": "[register] Register test user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Регистрация пользователя', () => {",
                  "    const isCreated = pm.response.code === 201;",
                  "    const isExists = pm.response.code === 409;",
                  "    pm.expect(isCreated || isExists, `Unexpected: ${pm.response.code}`).to.be.true;",
                  "    ",
                  "    if (isCreated) {",
                  "        const response = pm.response.json();",
                  "        pm.expect(response.username).to.eq(pm.environment.get('username'));",
                  "        console.log('Пользователь создан:', response.username);",
                  "    } else {",
                  "        console.log('Пользователь уже существует');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"{{email}}\"\n}"
            },
            "url": {
              "raw": "{{serviceUrl}}/api/v1/register",
              "host": ["{{serviceUrl}}"],
              "path": ["api", "v1", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "3. User Login",
      "item": [
        {
          "name": "[auth] Login as user (one-step)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// После всех редиректов токен должен быть в cookie",
                  "const token = pm.cookies.get('access_token');",
                  "",
                  "pm.test('Токен получен', () => {",
                  "    pm.expect(token).to.be.a('string');",
                  "    pm.expect(token).to.have.lengthOf.at.least(50);",
                  "});",
                  "",
                  "if (token) {",
                  "    pm.collectionVariables.set('authorizationToken', token);",
                  "    console.log('Токен пользователя сохранён, длина:', token.length);",
                  "} else {",
                  "    console.error('Токен не найден в cookie');",
                  "    console.error('Проверьте: Settings → General → Automatically follow redirects = ON');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{serviceUrl}}/api/v1/authorize?username={{username}}&password={{password}}",
              "host": ["{{serviceUrl}}"],
              "path": ["api", "v1", "authorize"],
              "query": [
                { "key": "username", "value": "{{username}}" },
                { "key": "password", "value": "{{password}}" }
              ]
            }
          }
        }
      ]
    },
